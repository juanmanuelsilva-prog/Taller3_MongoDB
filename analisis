    "# Celda 2 - Conectar a MongoDB y cargar datos\n",
    "client = MongoClient(\"mongodb://localhost:27017/\")\n",
    "db = client[\"taller3_db\"]\n",
    "collection = db[\"raw_data\"]\n",
    "\n",
    "datos = list(collection.find())\n",
    "df = pd.DataFrame(datos)\n",
    "\n",
    "# Extraer nombre de origin y location\n",
    "df[\"origin_name\"] = df[\"origin\"].apply(lambda x: x.get(\"name\", \"\") if isinstance(x, dict) else \"\")\n",
    "df[\"location_name\"] = df[\"location\"].apply(lambda x: x.get(\"name\", \"\") if isinstance(x, dict) else \"\")\n",
    "df[\"episode_count\"] = df[\"episode\"].apply(lambda x: len(x) if isinstance(x, list) else 0)\n",
    "\n",
    "# Columnas seleccionadas\n",
    "df = df[[\"_id\", \"name\", \"status\", \"species\", \"gender\", \"origin_name\", \"location_name\", \"episode_count\"]]\n",
    "\n",
    "print(f\"✓ Datos cargados: {len(df)} registros\")\n",
    "print(f\"✓ Columnas: {list(df.columns)}\")\n",
    "df.head()"
   ]
